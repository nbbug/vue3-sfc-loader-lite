{
  "name": "vue3-sfc-loader-lite",
  "version": "0.1.0",
  "description": "A lightweight Vue 3 Single File Component loader for the browser. No Babel, no PostCSS: scripts are plain ES modules and styles are plain CSS.",
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "sfc",
    "single-file-component",
    "component-loader",
    "nobuild"
  ],
  "license": "MIT",
  "author": {
    "name": "vue3-sfc-loader-lite contributors"
  },
  "type": "module",
  "main": "./dist/vue3-sfc-loader-lite.cjs",
  "module": "./dist/vue3-sfc-loader-lite.esm.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/vue3-sfc-loader-lite.js",
  "jsdelivr": "./dist/vue3-sfc-loader-lite.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-sfc-loader-lite.esm.js",
      "require": "./dist/vue3-sfc-loader-lite.cjs",
      "default": "./dist/vue3-sfc-loader-lite.esm.js"
    },
    "./precompile": {
      "types": "./dist/types/precompile.d.ts",
      "import": "./dist/precompile.esm.js",
      "require": "./dist/precompile.cjs",
      "default": "./dist/precompile.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build && vitest run test/integration",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run test:unit && npm run size"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "es-module-lexer": "3.0.5",
    "playwright-core": "^1.65.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.8",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "vue": "3.5.46"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "supports es6-module and supports dynamic-import"
  ],
  "dependencies": {
    "@vue/compiler-sfc": "3.5.46"
  }
}
